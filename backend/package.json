{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "set NODE_OPTIONS=--experimental-vm-modules&& npx jest --verbose",
    "test:user": "set NODE_OPTIONS=--experimental-vm-modules&& npx jest --verbose --testPathPatterns=tests/users/unit/",
    "test:auth": "set NODE_OPTIONS=--experimental-vm-modules&& npx jest --verbose --testPathPatterns=tests/auth/unit/",
    "test:project": "set NODE_OPTIONS=--experimental-vm-modules&& npx jest --verbose --testPathPatterns=tests/projects/unit/",
    "test:task": "set NODE_OPTIONS=--experimental-vm-modules&& npx jest --verbose --testPathPatterns=tests/tasks/unit/",
    "test:integration": "set NODE_OPTIONS=--experimental-vm-modules&& npx jest --verbose --testPathPatterns=integration/",
    "test:integration:auth": "set NODE_OPTIONS=--experimental-vm-modules&& npx jest --verbose --testPathPatterns=tests/auth/integration/",
    "test:integration:project": "set NODE_OPTIONS=--experimental-vm-modules&& npx jest --verbose --testPathPatterns=tests/projects/integration/",
    "test:integration:user": "set NODE_OPTIONS=--experimental-vm-modules&& npx jest --verbose --testPathPatterns=tests/users/integration/",
    "test:integration:task": "set NODE_OPTIONS=--experimental-vm-modules&& npx jest --verbose --testPathPatterns=tests/tasks/integration/",
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:rollback": "drizzle-kit undo",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:check": "node -e \"import { checkDbConnection } from './dist/config/db.config.js'\"" ,
    "seed:users": "tsx src/seeds/seed.users.ts",
    "seed:projects": "tsx src/seeds/seed.projects.ts",
    "seed:all": "tsx src/seeds/seed.users.ts && tsx src/seeds/seed.projects.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@types/validator": "^13.15.10",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^1.0.0-rc.4",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.22.0",
    "socket.io": "^4.8.3",
    "validator": "^13.15.35",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@swc/core": "^1.15.46",
    "@swc/jest": "^0.2.39",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^1.0.0-rc.4",
    "jest": "^30.4.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
